# Copy this file to .env and fill in the token. .env is gitignored.

# Bot account login (twitch.tv/chae_bot)
CHAEBOT_TWITCH_USERNAME=chae_bot
# OAuth token for chae_bot with chat:read and chat:edit scopes
CHAEBOT_TWITCH_TOKEN=
# Channel the bot joins
CHAEBOT_TWITCH_CHANNEL=chablades

# Optional: automatic token refresh. User tokens expire after a few hours;
# with these set, the bot gets a new one when Twitch rejects the old one.
# Use your own app from https://dev.twitch.tv/console/apps and a refresh
# token issued to it. With these set, CHAEBOT_TWITCH_TOKEN may be left empty.
# CHAEBOT_TWITCH_CLIENT_ID=
# CHAEBOT_TWITCH_CLIENT_SECRET=
# CHAEBOT_TWITCH_REFRESH_TOKEN=

# Optional: where saved data lives (default %AppData%\Chaebot)
# CHAEBOT_DATA_DIR=
